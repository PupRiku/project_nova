# ── Git LFS: route binary assets out of normal git history ──
# Committing binaries normally bloats the repo permanently, because
# every version is stored forever. LFS keeps pointers in git and the
# blobs in a separate store. Set this up on day one — retrofitting
# means rewriting history.

# Images
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.gif    filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text
*.svg    filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.ase    filter=lfs diff=lfs merge=lfs -text

# Audio
*.wav    filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text

# Fonts
*.ttf    filter=lfs diff=lfs merge=lfs -text
*.otf    filter=lfs diff=lfs merge=lfs -text

# Video (cutscenes / trailers, if any)
*.ogv    filter=lfs diff=lfs merge=lfs -text
*.mp4    filter=lfs diff=lfs merge=lfs -text

# ── Line endings: keep text files consistent cross-platform ─
*.gd     text eol=lf
*.tscn   text eol=lf
*.tres   text eol=lf
*.godot  text eol=lf
*.cfg    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
