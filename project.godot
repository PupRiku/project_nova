; Godot 4 project configuration.
; This is intentionally minimal — a working skeleton. Autoloads,
; the full input map, display settings, and layers get filled in
; during Phase 0/1. Edit via the Godot editor where possible so the
; editor keeps this file well-formed.

config_version=5

[application]

config/name="Indie RPG (working title)"
config/description="Menu-driven turn-based RPG with action commands."
run/main_scene=""
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

; Core action-command input. The single "timing" button is the heart
; of the Paper-Mario press and the Expedition-33 parry window.
ui_action_command={
"deadzone": 0.5,
"events": []
}

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
